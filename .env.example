DATABASE_URL=sqlite:///verso_companion.db
META_MUSE_API_KEY=
META_MUSE_ENDPOINT=https://api.meta.ai/v1

# Optional Muse tuning (defaults shown)
MUSE_MODEL=muse-spark-1.3
MUSE_TEMPERATURE=0.3
MUSE_MAX_TOKENS_SUGGESTION=800
MUSE_MAX_TOKENS_FINALIZE=800
MUSE_TIMEOUT=15.0
MUSE_MAX_RETRIES=2
MUSE_MAX_INPUT_CHARS=1500
MUSE_CACHE_TTL_SECONDS=300.0
MUSE_CACHE_MAX_ENTRIES=64

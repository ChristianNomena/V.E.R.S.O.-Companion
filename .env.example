DATABASE_URL=sqlite:///verso_companion.db
META_MUSE_API_KEY=
META_MUSE_ENDPOINT=https://api.meta.ai/v1

# Optional : Muse tuning (defaults shown)
MUSE_MODEL=muse-wonder-1.0
MUSE_TEMPERATURE=0.3
MUSE_REASONING_EFFORT=minimal
MUSE_MAX_TOKENS_SUGGESTION=800
MUSE_MAX_TOKENS_FINALIZE=800
MUSE_TIMEOUT=15.0
MUSE_MAX_RETRIES=2
MUSE_MAX_INPUT_CHARS=1500
MUSE_CACHE_TTL_SECONDS=300.0
MUSE_CACHE_MAX_ENTRIES=64

# Optional : TTS provider (defaults shown)
TTS_PROVIDER=piper
TTS_VOICE_NAME=Samantha
TTS_SPEECH_RATE=185
PIPER_VOICE=en_US-amy-medium
PIPER_DATA_DIR=
PIPER_USE_CUDA=false

# Optional : Partner observation tuning (defaults shown)
COMPANION_OBSERVE_INTERVAL_SECONDS=20.0
COMPANION_SPONTANEOUS_MIN_INTERVAL_SECONDS=600.0
COMPANION_SPONTANEOUS_EVERY_N_TICKS=3
COMPANION_CONTEXT_WINDOW_MINUTES=15
COMPANION_MAX_CLIPBOARD_CHARS=500
COMPANION_MIN_SNAPSHOTS_FOR_SPONTANEOUS=3
COMPANION_MAX_ASK_IMAGES=2
